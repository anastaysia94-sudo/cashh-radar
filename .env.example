# CASHH RADAR v2.2 — production environment template
# Do not commit real secrets. Set them directly in your hosting dashboard.

# REQUIRED FOR PUBLIC PRODUCTION
CASHH_SECRET_KEY=replace-with-at-least-32-random-characters
# Optional on Render: the app automatically uses RENDER_EXTERNAL_URL. Set this after adding a custom domain.
CASHH_PUBLIC_URL=
CASHH_COOKIE_SECURE=1
CASHH_DEV_MODE=0
CASHH_ADMIN_EMAIL=owner@example.com
CASHH_ADMIN_PASSWORD=replace-with-a-strong-unique-password
CASHH_SUPPORT_EMAIL=support@example.com

# LAUNCH SCHEDULER (recommended for the single-instance SQLite deployment)
CASHH_SCHEDULER_ENABLED=1
CASHH_SCHEDULER_TICK_SECONDS=60
CASHH_JOB_WEBHOOKS_SECONDS=300
CASHH_JOB_ALERTS_SECONDS=600
CASHH_JOB_SOURCES_SECONDS=1800
CASHH_JOB_DIGESTS_SECONDS=3600
CASHH_JOB_MAINTENANCE_SECONDS=21600
CASHH_JOB_BACKUPS_SECONDS=86400
CASHH_SCHEDULED_SOURCES=grants_gov
CASHH_BACKUP_DIR=/app/data/backups
CASHH_WEBHOOK_TIMEOUT=10

# ACCOUNT SECURITY
# Keep 0 if SMTP is not ready yet. Change to 1 after SMTP is configured/tested.
CASHH_REQUIRE_EMAIL_VERIFICATION=0

# TEAM / COMMERCIAL API LIMITS
CASHH_TEAM_SEAT_LIMIT=10
CASHH_API_PRO_RATE_LIMIT_PER_MINUTE=60
CASHH_API_ORG_RATE_LIMIT_PER_MINUTE=300

# OPTIONAL LIVE CONNECTORS
USAJOBS_API_KEY=
USAJOBS_EMAIL=
CASHH_LEVER_SITES=

# OPTIONAL STRIPE BILLING
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# OPTIONAL SMTP: password reset, verification, 2-step login, invites, digests
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# OPTIONAL protected Prometheus-style metrics endpoint
CASHH_METRICS_TOKEN=
