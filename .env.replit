# Cashh Radar — Replit Environment Template
# Copy values from Replit Secrets (lock icon) into your Replit project
# Do NOT commit this file with real secrets to GitHub

# REQUIRED FOR REPLIT DEPLOYMENT
CASHH_SECRET_KEY=replace-with-random-32-chars-in-replit-secrets
CASHH_PUBLIC_URL=your-replit-project-url.repl.co
CASHH_COOKIE_SECURE=1
CASHH_DEV_MODE=0
CASHH_ADMIN_EMAIL=your-email@example.com
CASHH_ADMIN_PASSWORD=your-strong-password
CASHH_SUPPORT_EMAIL=support@example.com

# LAUNCH SCHEDULER (enabled by default for Replit)
CASHH_SCHEDULER_ENABLED=1
CASHH_SCHEDULER_TICK_SECONDS=60
CASHH_JOB_WEBHOOKS_SECONDS=300
CASHH_JOB_ALERTS_SECONDS=600
CASHH_JOB_SOURCES_SECONDS=1800
CASHH_JOB_DIGESTS_SECONDS=3600
CASHH_JOB_MAINTENANCE_SECONDS=21600
CASHH_JOB_BACKUPS_SECONDS=86400
CASHH_SCHEDULED_SOURCES=grants_gov
CASHH_BACKUP_DIR=/app/data/backups
CASHH_WEBHOOK_TIMEOUT=10

# ACCOUNT SECURITY
# Keep 0 until SMTP is configured
CASHH_REQUIRE_EMAIL_VERIFICATION=0

# TEAM / API LIMITS
CASHH_TEAM_SEAT_LIMIT=10
CASHH_API_PRO_RATE_LIMIT_PER_MINUTE=60
CASHH_API_ORG_RATE_LIMIT_PER_MINUTE=300

# OPTIONAL: Add these to Replit Secrets when ready
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=
# CASHH_LEVER_SITES=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# CASHH_METRICS_TOKEN=
